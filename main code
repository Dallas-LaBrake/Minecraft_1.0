    // Fast Voxel DDA Raycaster
    function raycastVoxel(origin, dir, maxDist = 6) {
      let x = Math.floor(origin.x);
      let y = Math.floor(origin.y);
      let z = Math.floor(origin.z);

      const stepX = dir.x > 0 ? 1 : -1;
      const stepY = dir.y > 0 ? 1 : -1;
      const stepZ = dir.z > 0 ? 1 : -1;

      const tDeltaX = dir.x !== 0 ? Math.abs(1 / dir.x) : Infinity;
      const tDeltaY = dir.y !== 0 ? Math.abs(1 / dir.y) : Infinity;
      const tDeltaZ = dir.z !== 0 ? Math.abs(1 / dir.z) : Infinity;

      let tMaxX = dir.x > 0 ? (x + 1 - origin.x) * tDeltaX : (origin.x - x) * tDeltaX;
      let tMaxY = dir.y > 0 ? (y + 1 - origin.y) * tDeltaY : (origin.y - y) * tDeltaY;
      let tMaxZ = dir.z > 0 ? (z + 1 - origin.z) * tDeltaZ : (origin.z - z) * tDeltaZ;

      let normal = [0, 0, 0];
      let dist = 0;

      while (dist <= maxDist) {
        const block = getBlock(x, y, z);
        if (block !== BLOCK.AIR && block !== BLOCK.WATER) {
          return { x, y, z, normal, block };
        }

        if (tMaxX < tMaxY) {
          if (tMaxX < tMaxZ) {
            dist = tMaxX;
            x += stepX;
            tMaxX += tDeltaX;
            normal = [-stepX, 0, 0];
          } else {
            dist = tMaxZ;
            z += stepZ;
            tMaxZ += tDeltaZ;
            normal = [0, 0, -stepZ];
          }
        } else {
          if (tMaxY < tMaxZ) {
            dist = tMaxY;
            y += stepY;
            tMaxY += tDeltaY;
            normal = [0, -stepY, 0];
          } else {
            dist = tMaxZ;
            z += stepZ;
            tMaxZ += tDeltaZ;
            normal = [0, 0, -stepZ];
          }
        }
      }
      return null;
    }

