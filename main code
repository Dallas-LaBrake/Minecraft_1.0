    // AABB Collision check against solid world blocks
    function checkCollision(pos) {
      const halfW = player.width / 2;
      const minX = Math.floor(pos.x - halfW);
      const maxX = Math.floor(pos.x + halfW);
      const minY = Math.floor(pos.y);
      const maxY = Math.floor(pos.y + player.height);
      const minZ = Math.floor(pos.z - halfW);
      const maxZ = Math.floor(pos.z + halfW);

      for (let y = minY; y <= maxY; y++) {
        for (let z = minZ; z <= maxZ; z++) {
          for (let x = minX; x <= maxX; x++) {
            const b = getBlock(x, y, z);
            if (b !== BLOCK.AIR && BLOCK_PROPS[b].solid) {
              return true;
            }
          }
        }
      }
      return false;
    }

    // Left-Click Break & Right-Click Place
    window.addEventListener('mousedown', (e) => {
      if (!controls.isLocked) return;
      const dir = new THREE.Vector3();
      camera.getWorldDirection(dir);
      const hit = raycastVoxel(camera.position, dir, 6);
      if (!hit) return;

      if (e.button === 0) {
        // Break block
        setBlock(hit.x, hit.y, hit.z, BLOCK.AIR);
        rebuildWorldMesh();
      } else if (e.button === 2) {
        // Place block adjacent to hit face
        const px = hit.x + hit.normal[0];
        const py = hit.y + hit.normal[1];
        const pz = hit.z + hit.normal[2];
        if (!inBounds(px, py, pz)) return;

        // Prevent placing block inside player's AABB
        const blockToPlace = HOTBAR_BLOCKS[selectedSlot];
        const prevBlock = getBlock(px, py, pz);
        setBlock(px, py, pz, blockToPlace);
        if (checkCollision(player.pos)) {
          setBlock(px, py, pz, prevBlock); // Revert if colliding with player
        } else {
          rebuildWorldMesh();
        }
      }
    });
